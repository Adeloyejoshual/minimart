// server/api/ai-helper.js
import { Configuration, OpenAIApi } from "openai";

const configuration = new Configuration({
  apiKey: process.env.OPENAI_API_KEY,
});

const openai = new OpenAIApi(configuration);

export const handler = async (req, res) => {
  try {
    const { type, description } = req.body;

    if (!description) return res.status(400).json({ message: "Description required" });

    let prompt = "";

    if (type === "generateTitle") {
      prompt = `Generate a short, catchy title (5-8 words) for this product description:\n${description}`;
    } else if (type === "improveDescription") {
      prompt = `Improve this product description for clarity, attractiveness, and SEO. Add smart suggestions like condition, accessories, battery, warranty:\n${description}`;
    } else if (type === "seo") {
      prompt = `Suggest SEO keywords for this product description:\n${description}`;
    }

    const completion = await openai.createChatCompletion({
      model: "gpt-4",
      messages: [{ role: "user", content: prompt }],
      max_tokens: 100,
    });

    const result = completion.data.choices[0].message.content.trim();
    res.json({ result });
  } catch (err) {
    console.error(err);
    res.status(500).json({ message: "AI error" });
  }
};

export default handler;