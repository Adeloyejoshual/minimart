datasource db {
  provider = "cockroachdb"
  url      = env("COCKROACH_URI")
}

generator client {
  provider = "prisma-client-js"
}

model MiniMartProduct {
  id          String   @id @default(uuid())
  title       String
  description String?
  price       Float
  category    String?
  image_url   String?
  created_at  DateTime @default(now())
}