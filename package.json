{
  "name": "minimart-marketplace",
  "version": "1.3.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "serve": "nodemon server.js",
    "lint": "eslint . --ext .js,.jsx",
    "format": "prettier --write ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.14.1",
    "@auth0/auth0-react": "^2.0.0",
    "@paystack/inline-js": "^2.14.0",
    "react-paystack": "^6.0.0",
    "react-icons": "^4.11.0",
    "axios": "^1.6.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "mongoose": "^7.7.1",
    "dotenv": "^16.3.1",
    "pg": "^8.12.0",
    "cloudinary": "^2.8.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "react-helmet-async": "^2.0.5",
    "helmet": "^7.0.0",
    "compression": "^1.8.0",
    "express-rate-limit": "^7.0.0",
    "bullmq": "^2.11.0",
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "vite": "^4.5.14",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^8.47.0",
    "eslint-plugin-react": "^7.33.2",
    "prettier": "^3.5.0",
    "nodemon": "^3.0.2"
  },
  "eslintConfig": {
    "extends": ["eslint:recommended", "plugin:react/recommended"],
    "env": {
      "browser": true,
      "es2021": true,
      "node": true
    },
    "settings": {
      "react": {
        "version": "detect"
      }
    },
    "rules": {
      "react/prop-types": "off",
      "no-unused-vars": "warn",
      "no-console": "off"
    }
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "printWidth": 100,
    "trailingComma": "es5"
  }
}