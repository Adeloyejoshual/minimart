import React from "react";
import { useAuth0 } from "@auth0/auth0-react";

const TestAuth = () => {
  const { loginWithRedirect, logout, user, isAuthenticated, isLoading, error } = useAuth0();

  if (isLoading) return <div>Loading Auth...</div>;
  if (error) return <div style={{ color: "red" }}>Auth Error: {error.message}</div>;

  return (
    <div style={{ padding: 50, textAlign: "center", fontFamily: "sans-serif" }}>
      {!isAuthenticated ? (
        <>
          <h2>Auth0 Test</h2>
          <button onClick={() => loginWithRedirect({ screen_hint: "login" })} style={{ margin: 10, padding: "10px 20px" }}>
            Login
          </button>
          <button onClick={() => loginWithRedirect({ screen_hint: "signup" })} style={{ margin: 10, padding: "10px 20px" }}>
            Sign Up
          </button>
        </>
      ) : (
        <>
          <h2>Hello, {user.name}</h2>
          <p>{user.email}</p>
          <button onClick={() => logout({ logoutParams: { returnTo: "https://minimart-8k9g.onrender.com" } })}>
            Logout
          </button>
        </>
      )}
    </div>
  );
};

export default TestAuth;