{
  "name"             : "Loemart — Buy & Sell Near You",
  "short_name"       : "Loemart",
  "description"      : "Nigeria's neighbourhood marketplace — buy and sell phones, laptops, fashion, vehicles and more near you.",
  "start_url"        : "/?source=pwa",
  "scope"            : "/",
  "display"          : "standalone",
  "display_override" : ["window-controls-overlay", "standalone", "browser"],
  "orientation"      : "portrait-primary",
  "background_color" : "#F7F4EF",
  "theme_color"      : "#FF5C00",
  "lang"             : "en-NG",
  "dir"              : "ltr",
  "categories"       : ["shopping", "lifestyle"],

  "icons": [
    {
      "src"    : "/icons/icon-48.png",
      "sizes"  : "48x48",
      "type"   : "image/png",
      "purpose": "any"
    },
    {
      "src"    : "/icons/icon-72.png",
      "sizes"  : "72x72",
      "type"   : "image/png",
      "purpose": "any"
    },
    {
      "src"    : "/icons/icon-96.png",
      "sizes"  : "96x96",
      "type"   : "image/png",
      "purpose": "any"
    },
    {
      "src"    : "/icons/icon-128.png",
      "sizes"  : "128x128",
      "type"   : "image/png",
      "purpose": "any"
    },
    {
      "src"    : "/icons/icon-192.png",
      "sizes"  : "192x192",
      "type"   : "image/png",
      "purpose": "any"
    },
    {
      "src"    : "/icons/icon-192-maskable.png",
      "sizes"  : "192x192",
      "type"   : "image/png",
      "purpose": "maskable"
    },
    {
      "src"    : "/icons/icon-512.png",
      "sizes"  : "512x512",
      "type"   : "image/png",
      "purpose": "any"
    },
    {
      "src"    : "/icons/icon-512-maskable.png",
      "sizes"  : "512x512",
      "type"   : "image/png",
      "purpose": "maskable"
    }
  ],

  "screenshots": [
    {
      "src"          : "/screenshots/home-mobile.png",
      "sizes"        : "390x844",
      "type"         : "image/png",
      "form_factor"  : "narrow",
      "label"        : "Loemart home — browse listings near you"
    },
    {
      "src"          : "/screenshots/search-mobile.png",
      "sizes"        : "390x844",
      "type"         : "image/png",
      "form_factor"  : "narrow",
      "label"        : "Search phones, laptops and more"
    },
    {
      "src"          : "/screenshots/home-desktop.png",
      "sizes"        : "1280x800",
      "type"         : "image/png",
      "form_factor"  : "wide",
      "label"        : "Loemart on desktop"
    }
  ],

  "shortcuts": [
    {
      "name"       : "Browse Deals",
      "short_name" : "Deals",
      "url"        : "/deals?source=pwa-shortcut",
      "description": "See today's best deals",
      "icons"      : [{ "src": "/icons/shortcut-deals.png", "sizes": "96x96" }]
    },
    {
      "name"       : "Sell an Item",
      "short_name" : "Sell",
      "url"        : "/minimart/add?source=pwa-shortcut",
      "description": "Post a new listing",
      "icons"      : [{ "src": "/icons/shortcut-sell.png", "sizes": "96x96" }]
    },
    {
      "name"       : "Search",
      "short_name" : "Search",
      "url"        : "/search?source=pwa-shortcut",
      "description": "Search all listings",
      "icons"      : [{ "src": "/icons/shortcut-search.png", "sizes": "96x96" }]
    }
  ],

  "related_applications": [
    {
      "platform": "webapp",
      "url"     : "https://www.loemart.com/manifest.json"
