  "related_applications": [
    {
      "platform": "webapp",
      "url"     : "https://loemart.com"
    }
  ],

  "prefer_related_applications": false,

  "share_target": {
    "action"     : "/share",
    "method"     : "GET",
    "enctype"    : "application/x-www-form-urlencoded",
    "params"     : {
      "title": "title",
      "text" : "text",
      "url"  : "url"
    }
  },

  "protocol_handlers": [
    {
      "protocol": "web+loemart",
      "url"     : "/product?id=%s"
    }
  ]
